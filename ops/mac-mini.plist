<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Install on Mac Mini after first successful `npm run build`:

  1. Edit the two paths below to your project location
  2. cp ops/mac-mini.plist ~/Library/LaunchAgents/com.facebookarmy.station.plist
  3. launchctl load ~/Library/LaunchAgents/com.facebookarmy.station.plist

  Logs: /tmp/facebook-army.stdout.log and /tmp/facebook-army.stderr.log
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.facebookarmy.station</string>
    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USER/FacebookArmy</string>
    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/node</string>
      <string>/Users/YOUR_USER/FacebookArmy/apps/api/dist/index.js</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/facebook-army.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/facebook-army.stderr.log</string>
  </dict>
</plist>
