# Copy to .env during setup (or let `npm run setup` create it)
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
PROFILES_DIR=./profiles
SCREENSHOTS_DIR=./data/screenshots
# 64-char hex master key for encrypting stored passwords (auto-generated by setup)
MASTER_KEY=
# Dashboard admin token (auto-generated by setup) — send as X-Admin-Token
ADMIN_TOKEN=
# How often the engagement watcher runs (ms)
ENGAGEMENT_POLL_MS=600000
# Max concurrent Playwright actions
MAX_CONCURRENT_JOBS=2
# Min delay between actions on the same account (ms)
MIN_ACTION_GAP_MS=45000
